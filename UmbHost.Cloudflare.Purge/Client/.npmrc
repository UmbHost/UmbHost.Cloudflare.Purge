# @umbraco-cms/backoffice 17 declares a peer dependency on @hey-api/openapi-ts >=0.85.2.
# This project intentionally pins @hey-api/openapi-ts to 0.45.1 because the committed,
# self-contained generated client in src/backend-api/ targets that generator's output
# format. The generated client does not import from @hey-api/openapi-ts at runtime, so
# the peer mismatch is install-time only and safe to ignore.
legacy-peer-deps=true
